      "default": []
    },
    "maxAsinsPerRun": {
      "title": "Max ASINs per run",
      "type": "integer",
      "default": 50
    },
    "forceRescrape": {
      "title": "Force Rescrape",
      "type": "boolean",
      "default": false
    },
    "context": {
      "title": "Context Object",
      "description": "Optional metadata such as userId, source, etc.",
      "type": "object",
